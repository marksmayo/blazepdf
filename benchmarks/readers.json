      "id": "blazepdf-window",
      "name": "BlazePDF window",
      "product": "BlazePDF",
      "repository": "local",
      "path": ".",
      "adapter": "window-ready-signal",
      "work": "launch to visible document window",
      "executable": "target/release/blazepdf-window.exe",
      "ready_signal": "BLAZEPDF_FIRST_FRAME_READY",
      "environment": {
        "BLAZEPDF_BENCHMARK_READY": "1",
        "BLAZEPDF_BENCHMARK_MINIMAL": "1",
        "BLAZEPDF_BENCHMARK_SHELL_ONLY": "1"
      },
      "require_visible_window": true,
      "stable_window_ms": 25,
      "build": [
        "cargo",
        "build",
        "--release",
        "--bin",
        "blazepdf-window"
      ]
    },
